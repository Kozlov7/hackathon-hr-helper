# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.
# Authorization key из личного кабинета developers.sber.ru (длинная строка, не начинается с eyJ)
GIGACHAT_AUTH_KEY=
# Тариф ключа: PERS — физлица (так работает наш ключ), CORP/B2B — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Если выдали только Access token (eyJ...), впишите его сюда вместо ключа — живёт 30 минут
GIGACHAT_TOKEN=
